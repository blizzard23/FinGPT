# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL (used for invite links and auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hallo@nachklang.app

# Secret that protects the Vercel cron drip endpoint
CRON_SECRET=change-me

# Optional: reverse geocoding provider (degrades gracefully if unset)
# Uses BigDataCloud's free client endpoint by default; no key required.
